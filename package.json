{
  "name": "next-vision-films",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Next Vision Films — website. See docs/ARCHITECTURE.md.",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "sync": "astro sync",
    "archive:source": "node scripts/archive-source.mjs",
    "media:map": "node scripts/build-media-source-map.mjs",
    "routes:build": "node scripts/build-route-map.mjs",
    "fonts:build": "node scripts/build-fonts.mjs",
    "concepts:media": "node scripts/build-concept-media.mjs",
    "media:inspect": "node scripts/media-inspect.mjs",
    "media:build": "node scripts/media-build.mjs",
    "media:sync": "node scripts/media-sync.mjs",
    "media:verify": "node scripts/validate-media.mjs",
    "media:backup": "node scripts/media-backup.mjs",
    "media:pull": "node scripts/media-pull.mjs",
    "legal:build": "node scripts/build-legal.mjs",
    "legal:lock": "node scripts/lock-legal.mjs",
    "redirects:build": "node scripts/build-redirects.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "validate:media": "node scripts/validate-media.mjs",
    "validate:legal": "node scripts/validate-legal.mjs",
    "validate:routes": "node scripts/validate-routes.mjs",
    "validate:seo": "node scripts/validate-seo.mjs",
    "validate:analytics": "node scripts/validate-analytics.mjs",
    "test:forms": "node scripts/test-forms.mjs",
    "verify": "npm run validate:data && npm run test:access && npm run test:admin && npm run validate:legal && npm run icons:check && npm run check && npm run redirects:build && npm run build && npm run validate:routes && npm run validate:seo && npm run validate:analytics && npm run validate:pwa && npm run validate:media",
    "icons:build": "node scripts/build-icons.mjs",
    "icons:check": "node scripts/build-icons.mjs --check",
    "validate:pwa": "node scripts/validate-pwa.mjs",
    "preview:cloudflare": "npm run build && wrangler dev",
    "deploy": "node scripts/deploy.mjs dev",
    "deploy:dev": "node scripts/deploy.mjs dev",
    "deploy:prod": "node scripts/deploy.mjs prod",
    "deploy:dry": "npm run build && wrangler deploy --dry-run",
    "test:access": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/test-access.mjs",
    "test:admin": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/test-admin.mjs",
    "mock:github": "node scripts/mock-github.mjs"
  },
  "dependencies": {
    "astro": "7.2.10",
    "lenis": "^1.3.26"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/cloudflare": "14.2.6",
    "@astrojs/mdx": "8.0.0",
    "@astrojs/sitemap": "3.7.4",
    "typescript": "5.9.3",
    "wrangler": "4.128.0"
  }
}
