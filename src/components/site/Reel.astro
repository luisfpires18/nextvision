---
/**
 * The reel ("bobine") — DESIGN V2. One drawing, every size.
 *
 * A disc with eight film windows and a hub. The disc is `currentColor` and the windows
 * are `--reel-hole`, so the caller decides both from tokens and this file names no
 * colour. Optional text sits on the hub (LET'S TALK). Decorative unless the caller gives
 * it a name: the element it lives in carries the accessible name.
 */
interface Props { text?: string[] | undefined; class?: string | undefined }
const { text = [], class: cls } = Astro.props;
const angles = [0, 45, 90, 135, 180, 225, 270, 315];
const lineY = (i: number) => (text.length === 1 ? 4 : i === 0 ? -3 : 11);
---

<svg class:list={['reel', cls]} viewBox="-50 -50 100 100" aria-hidden="true" focusable="false">
  <circle r="50" fill="currentColor" />
  <g class="reel__holes">
    {angles.map((a) => <rect x="-9" y="-41" width="18" height="16" rx="2" transform={`rotate(${a})`} />)}
    {text.length === 0 && (
      <>
        <rect x="-1.5" y="-21" width="3" height="7" /><rect x="-1.5" y="14" width="3" height="7" />
        <rect x="-21" y="-1.5" width="7" height="3" /><rect x="14" y="-1.5" width="7" height="3" />
      </>
    )}
  </g>
  {text.map((line, i) => (
    <text class="reel__text" x="0" y={lineY(i)} font-size="12" text-anchor="middle">{line}</text>
  ))}
</svg>
