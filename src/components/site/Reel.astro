---
/**
 * The reel ("bobine") — DESIGN V2. One drawing, every size.
 *
 * A disc with eight film windows and a hub. The disc is `currentColor`, so the caller
 * decides it from tokens. The windows are real holes, cut with a mask, so they show whatever
 * is behind the reel as it rolls across the page; `white` and `black` below are what a mask
 * reads as keep and cut, not colours anyone sees. Optional text sits on the hub (LET'S TALK),
 * in `--reel-text`. Decorative unless the caller gives it a name: the element it lives in
 * carries the accessible name.
 */
interface Props { text?: string[] | undefined; class?: string | undefined }
const { text = [], class: cls } = Astro.props;
const angles = [0, 45, 90, 135, 180, 225, 270, 315];
const lineY = (i: number) => (text.length === 1 ? 4 : i === 0 ? -3 : 11);
// One per drawing on a page: the spine's reel has no text and the spool's has two lines.
const maskId = `reel-cut-${text.length}`;
---

<svg class:list={['reel', cls]} viewBox="-50 -50 100 100" aria-hidden="true" focusable="false">
  <mask id={maskId}>
    <rect x="-50" y="-50" width="100" height="100" fill="white" />
    <g fill="black">
      {angles.map((a) => <rect x="-9" y="-41" width="18" height="16" rx="2" transform={`rotate(${a})`} />)}
      {text.length === 0 && (
        <>
          <rect x="-1.5" y="-21" width="3" height="7" /><rect x="-1.5" y="14" width="3" height="7" />
          <rect x="-21" y="-1.5" width="7" height="3" /><rect x="14" y="-1.5" width="7" height="3" />
        </>
      )}
    </g>
  </mask>
  <circle r="50" fill="currentColor" mask={`url(#${maskId})`} />
  {text.map((line, i) => (
    <text class="reel__text" x="0" y={lineY(i)} font-size="12" text-anchor="middle">{line}</text>
  ))}
</svg>
