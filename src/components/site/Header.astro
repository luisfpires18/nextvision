---
/**
 * Site header.
 *
 * Emitted ONCE and restyled by CSS — never duplicated per breakpoint, which is what
 * gives the live site 20 tab stops for 4 destinations (audit §8.9).
 *
 * Readability over any ground is handled by the header theme system in site.css: each
 * section declares what is behind the header, and the header resolves its ink from that.
 * Nothing here hardcodes a colour.
 *
 * ── The language switch — PHASE 11 ──────────────────────────────────────────
 * It renders because a second locale finally HAS content. The rule it was built to
 * enforce has not been relaxed, only moved: it used to mean "never show a switch", and it
 * now means "never offer a page that was not built". So each control is a real link only
 * where `translatePath` returns a counterpart, and on the two Portuguese-only legal
 * documents the English control is not a link at all — it is a disabled item that says
 * why. The live site's own failure is a switch that leads to an empty page (audit §9.1);
 * a switch that leads nowhere and admits it is not that failure.
 *
 * It sits inside `.site-nav`, so it is in the mobile menu by construction rather than by
 * a second copy of the markup — fixing audit §9.2, where the switcher is invisible below
 * 768 px. Keyboard and touch operable, never hover-only.
 */
import { getEntry } from 'astro:content';
import { t } from '../../i18n/index.ts';
import {
  DEFAULT_LOCALE, activeLocales, LOCALE_LABELS, LOCALE_SHORT, LOCALE_TAGS, type Locale,
} from '../../config/i18n.ts';
import { navHref, isBuilt } from '../../lib/nav.ts';
import { pagePath, translatePath } from '../../i18n/routes.ts';
import { SECTION_ANCHORS } from '../../lib/homepage.ts';
import type { UIKey } from '../../i18n/pt.ts';
import type { PageId } from '../../i18n/routes.ts';

interface Props {
  locale?: Locale;
  /**
   * The other locale's counterpart, when this page knows it and `translatePath` cannot
   * work it out from the URL.
   *
   * Exactly one kind of page needs this: the error states. `/404.html` is not a route, so
   * translating its path returns null — and the switch would then say "this page exists
   * in Portuguese only", which is not true of a page that does not exist in any language.
   * The 404 supplies the other locale's home instead, and the offline shell supplies the
   * other locale's offline shell.
   */
  langAlternate?: Partial<Record<Locale, string>> | undefined;
}
const { locale = DEFAULT_LOCALE, langAlternate } = Astro.props;

const navigation = await getEntry('navigation', 'navigation');
const items = (navigation?.data.items ?? [])
  .filter((i) => i.showIn.includes('header'))
  .sort((a, b) => a.order - b.order);

/** Anchor id this item scrolls to while its real page is still to be built. */
const sectionOf = (id: PageId): string | undefined => {
  const map: Partial<Record<PageId, string>> = {
    portfolio: SECTION_ANCHORS.work,
    services: SECTION_ANCHORS.services,
    about: SECTION_ANCHORS.about,
    contact: SECTION_ANCHORS.contact,
  };
  return map[id];
};

const locales = activeLocales();

/** The path this header is being rendered on. The language switch translates it. */
const here = Astro.url.pathname;

/**
 * Active state has two sources, and they must not fight.
 *
 * A link to a route that EXISTS is current when the reader is on that route (or inside
 * it — a project page is inside the portfolio). A link that still resolves to a homepage
 * section is current when that section is in view, which the scroll handler decides at
 * runtime. Only the second kind carries `data-nav-section`.
 */
const isCurrentPage = (id: PageId): boolean => {
  if (!isBuilt(id)) return false;
  const target = pagePath(id, locale);
  return here === target || here.startsWith(target);
};
---

<header class="site-header">
  <a class="site-header__brand" href="/">Next Vision Films</a>

  <nav class="site-nav" id="site-nav" data-menu aria-label={t('nav.menu', locale)}>
    {items.map((item) => (
      <a
        href={navHref(item.pageId, locale)}
        data-nav-section={isBuilt(item.pageId) ? undefined : sectionOf(item.pageId)}
        aria-current={isCurrentPage(item.pageId) ? 'page' : undefined}
      >{t(item.labelKey as UIKey, locale)}</a>
    ))}

    {locales.length > 1 && (
      <span class="site-nav__lang" role="group" aria-label={t('lang.label', locale)}>
        {locales.map((l) => {
          const current = l === locale;
          const href = current ? null : (langAlternate?.[l] ?? translatePath(here, locale, l));
          /* The accessible name is the language's own name in its own language, so a
             Portuguese reader hears "Português" and an English one hears "English" —
             never a two-letter code read out as letters. */
          const label = LOCALE_LABELS[l];

          if (current) {
            return (
              <span lang={l} aria-current="true">
                <span aria-hidden="true">{LOCALE_SHORT[l]}</span>
                <span class="visually-hidden">{label}</span>
              </span>
            );
          }
          if (!href) {
            /* No counterpart was built. Not a link, not hidden, and it says why —
               `aria-disabled` rather than a dead href, so it is announced as
               unavailable instead of being followed into a 404. */
            return (
              <span class="site-nav__lang-off" lang={l} aria-disabled="true">
                <span aria-hidden="true">{LOCALE_SHORT[l]}</span>
                <span class="visually-hidden">{`${label} (${t('lang.noTranslation', l)})`}</span>
              </span>
            );
          }
          return (
            <a href={href} lang={l} hreflang={LOCALE_TAGS[l]} rel="alternate">
              <span aria-hidden="true">{LOCALE_SHORT[l]}</span>
              <span class="visually-hidden">{label}</span>
            </a>
          );
        })}
      </span>
    )}
  </nav>

  <button
    class="site-header__toggle"
    type="button"
    data-menu-toggle
    aria-expanded="false"
    aria-controls="site-nav"
    data-open={t('nav.menu', locale)}
    data-close={t('ui.close', locale)}
  ><span>{t('nav.menu', locale)}</span></button>
</header>

<style>
  /* Scoped to the switcher. Values still come from tokens; no raw colour, size or
     duration appears here (CLAUDE.md §4). */
  .site-nav__lang {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    letter-spacing: var(--tracking-eyebrow);
  }

  /**
   * Typography is declared on the ITEMS, not on the group.
   *
   * The two items are different elements by design — the current locale is a <span>
   * because it is not a link anywhere — and the open mobile menu restyles `a` to the
   * display face at service size. Setting the face on the group alone therefore produced
   * a switch whose two halves were different sizes and off the same baseline: the link
   * inherited the menu's rule and the span inherited the group's.
   *
   * Scoped through `.site-nav` so it outranks `.site-nav[data-open='true'] a` by
   * specificity rather than by source order, which is not guaranteed across bundled
   * stylesheets.
   */
  .site-nav .site-nav__lang a,
  .site-nav .site-nav__lang > span {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--t-metaline);
    font-weight: 400;
    /* Touch target, on the one control that is otherwise two characters tall. */
    padding-block: var(--space-3);
    padding-inline: var(--space-2);
    opacity: 0.62;
  }
  .site-nav .site-nav__lang [aria-current] { opacity: 1; font-weight: 700; }
  /* A locale with no counterpart on this page. Dimmer than the inactive link and not
     interactive — today that is only the two Portuguese-only legal documents. */
  .site-nav .site-nav__lang-off { opacity: 0.32; cursor: default; }
  /* The menu's underline belongs to destinations; a language is not one. */
  .site-nav .site-nav__lang a::after { content: none; }
</style>
