---
/**
 * Project page — ONE template, composed from what the project actually holds.
 *
 * Review D designed this on `leonor` and left the other nineteen on a placeholder.
 * Phase 9 removes the placeholder: every published project now renders the designed
 * page, and the page adapts to its material rather than demanding the same material
 * from every project.
 *
 *   the screen      always — a loop where we hold one, a frame where we do not
 *   the caption     always — title, category, date, and the published tagline where the
 *                   project does not carry that tagline as its own prose
 *   the blocks      only what the entry declares. Zero is a valid answer, and eight
 *                   projects publish nothing beyond a title and a film
 *   next / previous always
 *   related         only where the taxonomy can derive it honestly
 *
 * NOTHING here is per-project. A project gets a richer page by having richer content,
 * which is the same rule that used to select between two templates — only now there is
 * one template and the difference is a matter of degree instead of a cliff.
 *
 * The hero and every candidate frame carry `data-frame={slug}`, which is how the runtime
 * finds the element that is about to become — or to have been — the frame the reader
 * clicked. The view-transition name is applied to exactly that one element at the moment
 * of intent and released afterwards (src/lib/motion/transitions.ts). Where the API is
 * unavailable this is an ordinary navigation, because it was only ever a link.
 */
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectBlocks from '../project/ProjectBlocks.astro';
import NextProject from '../project/NextProject.astro';
import RelatedWork from '../project/RelatedWork.astro';
import { portfolioProjects } from '../../lib/curated.ts';
import { PORTFOLIO } from '../../lib/portfolio.ts';
import { relatedProjects } from '../../lib/related.ts';
import { getMedia, imageProps, videoProps, youtubeEmbedUrl } from '../../lib/media.ts';
import { screenRatio, frameRatio } from '../../lib/project-page.ts';
import { videoObjectSchema, breadcrumbSchema, absoluteUrl } from '../../lib/seo.ts';
import { t } from '../../i18n/index.ts';
import type { Locale } from '../../config/i18n.ts';
import { pagePath, projectPath } from '../../i18n/routes.ts';
import { say } from '../../lib/homepage.ts';
import { projectDescription } from '../../lib/page-meta.ts';
import '../../styles/project.css';

interface Props {
  locale: Locale;
  slug: string;
  blocks: CollectionEntry<'projects'>['data']['blocks'];
  /** The published film's id, so the screen can be its façade. */
  youtubeId: string | null;
}
const { locale, slug, blocks, youtubeId } = Astro.props;

const all = await portfolioProjects(locale);
const index = all.findIndex((p) => p.slug === slug);
const project = all[index];
if (!project) throw new Error(`No project entry for ${slug}`);

const previous = index > 0 ? all[index - 1]! : null;
const next = index < all.length - 1 ? all[index + 1]! : null;
const related = relatedProjects(all, index, 2);

/* ── hero media ────────────────────────────────────────────────────────────── */

// The keys the project NAMES — an owner may replace either from the admin, so nothing
// here is derived from the slug.
const heroKey = project?.heroKey ?? null;
const heroItem = heroKey ? getMedia(heroKey) : null;
const heroVideo = heroKey ? videoProps(heroKey) : null;
const heroLg = heroVideo?.mp4[0]?.src ?? null;
const heroSm = heroVideo?.mp4[1]?.src ?? heroLg;
const heroWebmLg = heroVideo?.webm[0]?.src ?? null;
const heroWebmSm = heroVideo?.webm[1]?.src ?? heroWebmLg;
/* The hero's own poster where one exists, and the card still otherwise — each with its
   OWN srcset, never one image's src beside another image's renditions. */
const heroStill = project?.heroStillKey ?? (heroKey ? `${heroKey}/poster` : null);
const heroPosterKey = heroStill && getMedia(heroStill) ? heroStill : (project?.posterKey ?? '');
const heroPoster = imageProps(heroPosterKey, { sizes: '(min-width: 72rem) 1140px, 92vw', priority: true });

/**
 * A published project with no image at all would render an empty black screen and look
 * like a bug rather than like a gap. Twenty out of twenty have an archived poster, so
 * this is a guard against a future edit, not a live condition — and it fails the BUILD
 * rather than shipping the hole.
 */
if (!heroPoster) {
  throw new Error(
    `Project "${slug}" has no hero image: neither ${heroStill ?? 'a hero still'} nor ${project?.posterKey ?? 'a poster'} ` +
    'resolves in the media manifest. Every published project must have something to show.',
  );
}

/* The screen is the wall; the film keeps its own shape inside it. */
const screenAr = screenRatio(getMedia(heroPosterKey));
/* Every frame further down the page is the film's shape, not a shape we chose. §A55. */
const filmAr = frameRatio(getMedia(heroPosterKey));

/**
 * The tagline appears exactly once.
 *
 * Where a project publishes prose long enough to carry the page, the entry declares it as
 * a `text` block and the caption stays quiet. Where the tagline is a single line, the
 * block would be an over-scaled restatement of the title, so it reads as a lead under the
 * title instead. Which of the two applies is decided by the content, not by a flag.
 */
const taglineIsProse = blocks.some(
  (b) => b.type === 'text' && (b.body[locale] ?? b.body.pt).trim() === project.tagline?.trim(),
);
const captionLead = taglineIsProse ? null : project.tagline;

/* ── SEO ───────────────────────────────────────────────────────────────────── */

/**
 * The description, PHASE 11.
 *
 * The live site publishes an og:description on none of the twenty project pages. Where a
 * project has a tagline that tagline IS the description — it is the only prose the source
 * gives and it is what the work says about itself. Where it has none, the description is
 * assembled from facts the content already holds and nothing else; no atmosphere is
 * written for a film we were told nothing about (src/lib/page-meta.ts).
 */
const description = projectDescription({
  title: project.title,
  tagline: project.tagline,
  categoryName: project.categoryName,
  year: Number(project.iso.slice(0, 4)),
}, locale);

const schema: Record<string, unknown>[] = [
  breadcrumbSchema([
    { name: say(PORTFOLIO.title, locale), path: pagePath('portfolio', locale) },
    { name: project.title, path: projectPath(slug, locale) },
  ]),
];
// Only with a real film and a real still — a partial VideoObject is worse than none.
if (project.filmUrl && project.posterSrc) {
  schema.push(videoObjectSchema({
    name: project.title,
    description,
    thumbnailUrl: absoluteUrl(project.posterSrc),
    uploadDate: project.iso,
    embedUrl: project.filmUrl,
    // The film is on YouTube in every case, so the page and the film share a language
    // only by accident. `inLanguage` is deliberately not claimed.
  }));
}
---

<BaseLayout
  section="cinema"
  title={project.title}
  description={description}
  locale={locale}
  ground="dark"
  ogImage={project.posterSrc ? absoluteUrl(project.posterSrc) : null}
  ogImageAlt={project.title}
  ogType="video.other"
  schema={schema}
>
  {/* ── THE DARK ROOM ─────────────────────────────────────────────────────
      One screen, projected inside the room at the width the film actually is —
      1140px — rather than stretched across the viewport. Nothing is upscaled,
      and the title sits under the frame, never over the footage.

      The screen is also the film. It arrives as a silent caption-free loop where
      we hold one, and becomes the published film the moment someone presses play:
      no second player lower down, and no YouTube contact until that press. */}
  <section class="pj-hero ground-dark" data-hero data-ground="dark" data-header="dark" style={`--film-ar:${filmAr}`}>
    <div class="pj-hero__inner">
      {/* Back to the work. A real link to the portfolio, so it works with scripting off
          and from a shared URL; the script below turns it into history.back() when the
          reader came from inside the site, so the portfolio keeps its filter and scroll. */}
      <a class="pj-back" href={pagePath('portfolio', locale)} data-back>
        <svg viewBox="0 0 22 22" aria-hidden="true"><path d="M14 4l-7 7 7 7" /></svg>
        <span>{t('ui.back', locale)}</span>
      </a>
      <div
        class={`pj-screen${screenAr < 1 ? ' pj-screen--poster' : ''}`}
        style={`--screen-ar:${screenAr}`}
        data-media
        data-header-zone
        data-film={youtubeId ? '' : undefined}
        data-embed={youtubeId ? youtubeEmbedUrl(youtubeId) : undefined}
        data-title={project.title}
        data-frame={slug}
      >
        <picture>
          {heroPoster.avifSrcset && <source type="image/avif" srcset={heroPoster.avifSrcset} sizes={heroPoster.sizes} />}
          <img
            src={heroPoster.src}
            srcset={heroPoster.srcset}
            sizes={heroPoster.sizes}
            alt=""
            width={heroPoster.width}
            height={heroPoster.height}
            fetchpriority="high"
            decoding="sync"
          />
        </picture>
        {heroLg && (
          <video
            data-src-lg={heroLg}
            data-src-sm={heroSm}
            data-src-webm-lg={heroWebmLg ?? undefined}
            data-src-webm-sm={heroWebmSm ?? undefined}
            poster={heroPoster.src}
            width={heroItem?.width}
            height={heroItem?.height}
            muted loop playsinline preload="none" aria-hidden="true"
          ></video>
        )}
        {youtubeId && (
          <>
            <button class="pj-play" type="button" data-film-play>
              <span class="pj-play__label">{t('media.playFilm', locale)}</span>
              <span class="visually-hidden">{`${t('media.playFilm', locale)}: ${project.title}`}</span>
            </button>
            {/* The façade is a script that swaps a player in, so with scripting off the
                button is inert and the film would be unreachable. Every other route on
                this page is an ordinary anchor; this makes the film one too. */}
            <noscript>
              <a class="pj-play" href={project.filmUrl!} rel="noopener" target="_blank">
                <span class="pj-play__label">{t('media.playFilm', locale)}</span>
                <span class="visually-hidden">{`${t('media.playFilm', locale)}: ${project.title}`}</span>
              </a>
            </noscript>
          </>
        )}
      </div>

      <div class="pj-caption">
        <h1 class="pj-title">{project.title}</h1>
        {captionLead && <p class="pj-lead">{captionLead}</p>}
        <p class="metaline">
          <span class={`item__dot cat-${project.categoryToken}`} aria-hidden="true"></span>
          <span>{project.categoryName}</span>
          <span>{project.date}</span>
          {/* One published project's video reference is broken on the live site (D6).
              The page states the fact rather than offering a film that is not there. */}
          {project.filmUnavailable && <span class="item__flag">{t('project.noFilm', locale)}</span>}
        </p>
      </div>
    </div>
  </section>

  <ProjectBlocks blocks={blocks} title={project.title} locale={locale} filmAr={filmAr} />

  <NextProject next={next} previous={previous} locale={locale}>
    <RelatedWork projects={related} category={project.categoryName} locale={locale} />
  </NextProject>
</BaseLayout>

<script>
  /**
   * The back link goes BACK when there is somewhere in the site to go back to: an earlier
   * ClientRouter entry (it numbers its history states) or a same-origin referrer on a full
   * load. Otherwise it stays the plain link to the portfolio.
   *
   * Capture phase, on the document once: it runs before the router's own click handler,
   * which ignores a click whose default was already prevented. A modified click (new tab)
   * is left to the browser.
   */
  const cameFromSite = () => {
    if ((history.state?.index ?? 0) > 0) return true;
    try { return new URL(document.referrer).origin === location.origin; } catch { return false; }
  };

  document.addEventListener('click', (e) => {
    const link = (e.target as Element | null)?.closest?.('[data-back]');
    if (!link || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    if (history.length < 2 || !cameFromSite()) return;
    e.preventDefault();
    history.back();
  }, true);
</script>
