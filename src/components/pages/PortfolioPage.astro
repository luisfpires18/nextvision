---
/**
 * Portfolio — REVIEW C. The canonical index.
 *
 * On WordPress this URL serves the CPT archive: five category cards, and seeing all the
 * work means visiting five separate pages. Yoast also lists an unreachable page id 36 for
 * it (audit §1.1, ROUTE_MIGRATION §6). This route now has ONE meaning — the complete,
 * curated catalogue, with the categories demoted to filters over it.
 *
 * SEO metadata is the live page's own, verbatim. Every one of the twenty projects is a
 * real link in the served HTML; nothing about the catalogue is client-side only.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortfolioIndex from '../portfolio/PortfolioIndex.astro';
import CinemaShelf from '../portfolio/CinemaShelf.astro';
import { BRAND_LINES } from '../../lib/brand.ts';
import { t } from '../../i18n/index.ts';
import { portfolioProjects } from '../../lib/curated.ts';
import { PORTFOLIO } from '../../lib/portfolio.ts';
import { organizationSchema, websiteSchema, absoluteUrl } from '../../lib/seo.ts';
import { pagePath } from '../../i18n/routes.ts';
import type { Locale } from '../../config/i18n.ts';
import { getEntry } from 'astro:content';
import { say } from '../../lib/homepage.ts';
import { pageTitle, pageDescription } from '../../lib/page-meta.ts';
import '../../styles/portfolio.css';
import '../../styles/sections.css';

interface Props { locale: Locale }
const { locale } = Astro.props;
const projects = await portfolioProjects(locale);
const settings = await getEntry('settings', 'site');

/**
 * A CollectionPage listing every project, so the catalogue is legible to a crawler as a
 * list rather than as twenty unrelated links. Only real, published fields are emitted.
 */
const schema = [
  organizationSchema({
    sameAs: (settings?.data.socials ?? []).map((s) => s.url),
    email: settings?.data.email ?? null,
  }),
  websiteSchema(locale),
  {
    '@type': 'CollectionPage',
    name: say(PORTFOLIO.title, locale),
    url: absoluteUrl(pagePath('portfolio', locale)),
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: projects.length,
      itemListElement: projects.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: absoluteUrl(p.href),
        name: p.title,
      })),
    },
  },
];

/* Measured (docs/PERFORMANCE_AUDIT.md): the first screen is the tagline in Condensed 900
   (the LCP element), the shelf's spine titles in Condensed 700 and the intro in Barlow
   400. The default pair left the LCP face to stylesheet discovery, and its swap moved
   everything beneath it. */
const CINEMA_FACES = ['barlow-condensed-900', 'barlow-condensed-700', 'barlow-400'];
---

<BaseLayout
  section="cinema"
  preloadFonts={CINEMA_FACES}
  title={pageTitle('portfolio', locale)}
  description={pageDescription('portfolio', locale) ?? undefined}
  locale={locale}
  ground="cream"
  schema={schema}
>
  {/* DESIGN V2 (Tatiana) — Cinema. LOVING EVERY FRAME, the VHS shelf with one film stood
      up as a poster, and the list. Both views are complete indexes of all the work; the
      list IS the Review C index, with its filters and its routes, re-set as rows. */}
  <div class="cinema ground-cream" data-cinema data-view="both">
    <p class="tagline cinema__tagline" aria-hidden="true">{BRAND_LINES.tagline}</p>
    <div class="cinema__views" role="group" aria-label={t('cinema.view', locale)}>
      <button type="button" data-view-set="shelf" aria-pressed="true">
        <svg viewBox="0 0 30 26" aria-hidden="true"><path d="M1 1h4v24H1zM7 1h4v24H7zM13 1h4v24h-4zM19 1h4v24h-4zM25 1h4v24h-4z" /></svg>
        <span class="visually-hidden">{t('cinema.shelf', locale)}</span>
      </button>
      <button type="button" data-view-set="list" aria-pressed="false">
        <svg viewBox="0 0 30 26" aria-hidden="true"><path d="M1 1h28v3H1zM1 8h28v3H1zM1 15h28v3H1zM1 22h28v3H1z" /></svg>
        <span class="visually-hidden">{t('cinema.list', locale)}</span>
      </button>
    </div>
    <CinemaShelf projects={projects} locale={locale} />
    <div class="cinema__list">
      <PortfolioIndex
        projects={projects}
        total={projects.length}
        heading={say(PORTFOLIO.title, locale)}
        enhance
        locale={locale}
      />
    </div>
  </div>
</BaseLayout>
