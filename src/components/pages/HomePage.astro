---
/**
 * Homepage — DESIGN V2 (Tatiana).
 *
 * The storyboard's homepage is one frame: the film, full-bleed, with "We are NVF" over it
 * and the logo at its foot. Everything else lives in its own section, one stripe of the
 * rail away, so the page no longer carries the Review B editorial rows, the feature, the
 * services list or the about excerpt — each of those is now the page it was excerpting.
 *
 * The opening sequence plays here, and only here (decision C5).
 *
 * ── The words ────────────────────────────────────────────────────────────────
 * "We are NVF" is the live site's own <title> suffix (src/lib/brand.ts). The company
 * statement under it is the live homepage's two published lines, unchanged, and it is
 * still the page's single <h1> — the wordmark is set as display type above it, so the
 * heading a reader or a crawler meets is the published sentence, not a slogan.
 *
 * ── The film ─────────────────────────────────────────────────────────────────
 * Tatiana's frame is the night portrait from `ana-reels`. It is attached by the runtime
 * exactly like the Review B hero (data-hero, site-motion.ts): nothing is fetched below the
 * `full` tier, and the poster is the designed state there.
 */
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandMark from '../site/BrandMark.astro';
import { getMedia, imageProps, videoProps } from '../../lib/media.ts';
import { organizationSchema, websiteSchema, absoluteUrl } from '../../lib/seo.ts';
import { pageTitle, pageDescription } from '../../lib/page-meta.ts';
import { BRAND_LINES } from '../../lib/brand.ts';
import type { Locale } from '../../config/i18n.ts';
import { HOME, say } from '../../lib/homepage.ts';

interface Props { locale: Locale }
const { locale } = Astro.props;

const settings = await getEntry('settings', 'site');

/* ── hero media ───────────────────────────────────────────────────────────── */

const heroKey = 'projects/ana-reels/hero';
const heroItem = getMedia(heroKey);
const hero = videoProps(heroKey);
/* The LCP image on the site's front page: eager, high priority, and never lazy. */
const heroPosterImg = imageProps(`${heroKey}/poster`, { alt: '', sizes: '100vw', priority: true });
const heroPoster = hero?.poster ?? null;
const heroLg = hero?.mp4[0]?.src ?? null;
const heroSm = hero?.mp4[1]?.src ?? heroLg;
const heroWebmLg = hero?.webm[0]?.src ?? null;
const heroWebmSm = hero?.webm[1]?.src ?? heroWebmLg;

/* ── SEO ──────────────────────────────────────────────────────────────────── */

const schema = [
  organizationSchema({
    sameAs: (settings?.data.socials ?? []).map((s) => s.url),
    // Deliberately null: the canonical address is contested (decision D2).
    email: settings?.data.email ?? null,
  }),
  websiteSchema(locale),
];
---

<BaseLayout
  section="home"
  intro
  title={pageTitle('home', locale)}
  description={pageDescription('home', locale) ?? undefined}
  locale={locale}
  ground="dark"
  ogImage={heroPoster ? absoluteUrl(heroPoster) : null}
  ogImageAlt={`${say(HOME.heroLineA, locale)} ${say(HOME.heroLineB, locale)}`}
  schema={schema}
>
  <section class="hero hero--v2 ground-dark" data-hero data-ground="dark" data-cursor="dark">
    <div class="hero__media" data-media>
      {heroPosterImg && (
        <picture>
          {heroPosterImg.avifSrcset && <source type="image/avif" srcset={heroPosterImg.avifSrcset} sizes={heroPosterImg.sizes} />}
          <img
            src={heroPosterImg.src}
            srcset={heroPosterImg.srcset}
            sizes={heroPosterImg.sizes}
            alt=""
            width={heroItem?.width}
            height={heroItem?.height}
            fetchpriority="high"
            decoding="sync"
          />
        </picture>
      )}
      {heroLg && (
        <video
          data-src-lg={heroLg}
          data-src-sm={heroSm}
          data-src-webm-lg={heroWebmLg ?? undefined}
          data-src-webm-sm={heroWebmSm ?? undefined}
          poster={heroPoster ?? undefined}
          width={heroItem?.width}
          height={heroItem?.height}
          muted
          loop
          playsinline
          preload="none"
          aria-hidden="true"
        ></video>
      )}
    </div>

    <div class="hero__centre">
      <p class="hero__wordmark" aria-hidden="true">{BRAND_LINES.wordmark}</p>
      <h1 class="hero__statement">
        <span>{say(HOME.heroLineA, locale)}</span> <span>{say(HOME.heroLineB, locale)}</span>
      </h1>
    </div>

    <svg class="hero__asterisk" viewBox="-12 -12 24 24" aria-hidden="true">
      <path d="M0-10V10M-10 0H10M-7-7 7 7M-7 7 7-7" />
    </svg>

    <div class="hero__marks" aria-hidden="true">
      <BrandMark mark="monogram" />
      <BrandMark mark="mono" />
      <BrandMark mark="stack" />
    </div>
  </section>
</BaseLayout>

<style>
  .hero--v2 { min-block-size: 100svh; display: grid; place-items: center; overflow: hidden; }
  @media (max-width: 47.99rem) {
    .hero--v2 { min-block-size: calc(100svh - var(--header-h) - var(--rail-bar)); }
  }
  .hero--v2 .hero__media::after { background: var(--scrim-text); }

  .hero__centre { position: relative; z-index: 1; text-align: center; padding-inline: var(--gutter); }
  .hero__wordmark {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--w-display);
    font-size: var(--t-statement);
    line-height: var(--lh-poster);
    color: var(--brand-yellow);
  }
  /* The published statement, under the wordmark, at reading weight. */
  .hero--v2 .hero__statement {
    margin: var(--space-4) 0 0;
    font-size: var(--t-hero-line);
    color: var(--ink-on-dark);
  }

  .hero__asterisk {
    position: absolute;
    z-index: 1;
    inset-inline-end: 9%;
    inset-block-start: 63%;
    inline-size: var(--space-5);
    fill: none;
    stroke: var(--brand-yellow);
    stroke-width: 3.4;
    stroke-linecap: round;
  }

  /* The logo at the foot of the frame cycles through its three lockups — N, NVF, NEXT
     VISION FILMS — three times, then rests on NVF. A loop that never ends is a frame
     loop by another name, so it ends. Each lockup holds for a third of the cycle;
     `backwards` keeps the later ones hidden until their turn. */
  .hero__marks {
    position: absolute;
    z-index: 1;
    inset-block-end: var(--space-5);
    inset-inline-start: 50%;
    inline-size: var(--space-9);
    block-size: var(--space-7);
    transform: translateX(-50%);
    color: var(--ink-on-dark);
  }
  .hero__marks > * {
    position: absolute;
    inset: 0;
    block-size: 100%;
    opacity: 0;
    animation: nvf-cycle calc(var(--dur-reveal) * 9) linear 3 backwards;
  }
  .hero__marks > :nth-child(2) { opacity: 1; animation-delay: calc(var(--dur-reveal) * 3); }
  .hero__marks > :nth-child(3) { animation-delay: calc(var(--dur-reveal) * 6); }
  @keyframes nvf-cycle {
    0% { opacity: 0; }
    3%, 30% { opacity: 1; }
    33%, 100% { opacity: 0; }
  }
  :root[data-motion='minimal'] .hero__marks > *,
  :root[data-motion='reduced'] .hero__marks > * { animation: none; }
</style>
