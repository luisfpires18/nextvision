---
/**
 * /servicos/ — PHASE 10.
 *
 * The page is the mark, its title, the stage and LET'S TALK. The owners asked for the text
 * to go on 2026-10-29, so the lead, the four services and the closing invitation stay in
 * services.json and the services collection, unrendered and never deleted (CLAUDE.md §2).
 *
 * ── The stage, 2026-11-06 ─────────────────────────────────────────────────────
 * The storyboard's collage (a large frame over two smaller ones), as a carousel. It opens on
 * the stills the data names in `collage` (the owners add and remove them in the admin), then runs through the projects of the
 * `categories` it also names, in portfolio order. A still that belongs to no published
 * project, such as a fresh owner upload, is still shown but links nowhere. The behaviour
 * is src/lib/stage.ts; without scripting the frames are a row of plain links.
 *
 * Under it, the films in `films` (services.json), top to bottom, each on the same façade as a
 * project page: nothing reaches YouTube until someone presses play. None is allowed.
 */
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandMark from '../site/BrandMark.astro';
import Reel from '../site/Reel.astro';
import FilmFacade from '../project/FilmFacade.astro';
import { SERVICES_PAGE } from '../../lib/static-pages.ts';
import { PAGE_CONTENT } from '../../lib/page-content.ts';
import { imageProps } from '../../lib/media.ts';
import { navHref } from '../../lib/nav.ts';
import { portfolioProjects } from '../../lib/curated.ts';
import { slotOf } from '../../lib/stage.ts';
import { organizationSchema, breadcrumbSchema, absoluteUrl } from '../../lib/seo.ts';
import type { Locale } from '../../config/i18n.ts';
import { pagePath } from '../../i18n/routes.ts';
import { t } from '../../i18n/index.ts';
import { say } from '../../lib/homepage.ts';
import { pageTitle, pageDescription } from '../../lib/page-meta.ts';
import '../../styles/pages.css';
import '../../styles/project.css';
import '../../styles/sections.css';

interface Props { locale: Locale }
const { locale } = Astro.props;

const settings = await getEntry('settings', 'site');

/** The page's og:image. It is no longer shown on the page itself. */
const leadImage = imageProps(PAGE_CONTENT.services.leadImage, { alt: '' });

/**
 * The stage's frames: the collage's stills, then every project in the named categories. A
 * category slug that names no visible category fails the build. A project counts in every
 * category it carries, not only its first, and appears once however many it is in.
 */
const projects = await portfolioProjects(locale);
const inCategory = new Map((await getCollection('projects')).map((p) => [p.id, new Set(p.data.categories.map((c) => c.id))]));
for (const slug of PAGE_CONTENT.services.categories) {
  const cat = await getEntry('categories', slug);
  if (!cat || cat.data.hidden) throw new Error(`services.json categories: "${slug}" is not a visible category`);
}
const keys = [
  ...PAGE_CONTENT.services.collage,
  ...projects
    .filter((p) => PAGE_CONTENT.services.categories.some((slug) => inCategory.get(p.slug)?.has(slug)))
    .map((p) => p.posterKey),
];
const FRAME_SIZES = '(min-width: 48rem) 34vw, 72vw';
const frames = [...new Set(keys)].flatMap((key) => {
  const image = imageProps(key, { alt: '', sizes: FRAME_SIZES });
  if (!image) return [];
  const project = projects.find((p) => p.posterKey === key);
  return [{ key, image, href: project?.href ?? null, title: project?.title ?? '' }];
});
/** The collage's middle still opens in front, as it does in the storyboard. */
const OPENING_CENTRE = Math.min(1, frames.length - 1);

const schema = [
  organizationSchema({
    sameAs: (settings?.data.socials ?? []).map((s) => s.url),
    email: settings?.data.email ?? null,
  }),
  breadcrumbSchema([
    { name: 'Next Vision Films', path: pagePath('home', locale) },
    { name: say(SERVICES_PAGE.title, locale), path: pagePath('services', locale) },
  ]),
];
---

<BaseLayout
  section="commercial"
  title={pageTitle('services', locale)}
  description={pageDescription('services', locale) ?? undefined}
  locale={locale}
  ground="cream"
  ogType="article"
  ogImage={leadImage ? absoluteUrl(leadImage.src) : null}
  schema={schema}
>
  {/* ── DESIGN V2 (Tatiana) — Commercial ───────────────────────────────────
      The colour NVF, the page title, the stage and the film. The same reel as /sobre/ rolls along
      the foot with the scroll and comes to rest as LET'S TALK, the page's own invitation
      to /contactos/. */}
  <section class="cm ground-cream" data-ground="cream">
    <BrandMark mark="colour" class="cm__mark" />
    <h1 class="cm__title" id="page-title">{say(SERVICES_PAGE.title, locale)}</h1>

    <section class="stage" data-stage aria-labelledby="page-title">
      <ul class="stage__frames">
        {frames.map((frame, i) => {
          const slot = slotOf(i, OPENING_CENTRE, frames.length);
          const picture = (
            <picture>
              {frame.image.avifSrcset && <source type="image/avif" srcset={frame.image.avifSrcset} sizes={frame.image.sizes} />}
              <img
                src={frame.image.src}
                srcset={frame.image.srcset}
                sizes={frame.image.sizes}
                alt=""
                loading={slot === 'back' ? 'lazy' : 'eager'}
                fetchpriority={slot === 'centre' ? 'high' : 'auto'}
                decoding="async"
              />
            </picture>
          );
          return (
            <li class="stage__frame" data-slot={slot} data-title={frame.title}>
              {frame.href ? (
                <a class="stage__link" href={frame.href} draggable="false">
                  {picture}
                  <span class="visually-hidden">{frame.title}</span>
                </a>
              ) : picture}
            </li>
          );
        })}
      </ul>
      <div class="stage__nav">
        <button type="button" class="stage__step" data-stage-step="-1" aria-label={t('ui.previous', locale)}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
        </button>
        <button type="button" class="stage__step" data-stage-step="1" aria-label={t('ui.next', locale)}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
        </button>
      </div>
      <p class="visually-hidden" aria-live="polite" data-stage-status></p>
    </section>

    {PAGE_CONTENT.services.films.map((film) => (
      <div class="cm__film">
        <FilmFacade videoId={film.id} posterKey={film.poster} title={film.title} locale={locale} />
      </div>
    ))}
  </section>

  <a class="spool" href={`${navHref('contact', locale)}#contactar`}>
    <i class="spool__film" aria-hidden="true"></i>
    <Reel class="spool__reel" text={[PAGE_CONTENT.brand.talk.a, PAGE_CONTENT.brand.talk.b]} />
    <span class="visually-hidden">{t('ui.letsTalk', locale)}</span>
  </a>
</BaseLayout>
