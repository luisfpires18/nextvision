---
/**
 * /servicos/ — PHASE 10.
 *
 * The homepage shows one sentence per service. This page shows all four in full, on the
 * same ruled index — so the two pages are recognisably the same list read at two
 * distances, not two designs of the same content.
 *
 * ── Four services, not five categories ───────────────────────────────────────
 * `Ficção`, `Visual Storytelling`, `Casamentos`, `Corporativo` and `Moda & Identidade`
 * are portfolio TAXONOMY. `Produção de Vídeo`, `Publicidade & Branding`,
 * `Eventos & Experiências` and `Documentários & Storytelling` are the SERVICES. The live
 * site publishes both lists and they do not correspond (audit §3.5). Merging them would
 * invent an offer the company does not make, so nothing on this page mentions a category.
 *
 * ── The signature, and it is the source's own ────────────────────────────────
 * The live page sets three phrases of its lead on a yellow ground — `transformar`,
 * `ideias`, `visão autêntica`. That published emphasis is reproduced, and it is the one
 * place on this site where gold behaves exactly as the token rules require: a surface
 * with ink on it at 7.56:1, never text (ARCHITECTURE §5.2). Nothing else on the page is
 * marked.
 *
 * ── What is NOT here, and why ────────────────────────────────────────────────
 * The live page ends with a form whose heading reads `Vamos Conversar!` and whose submit
 * button reads `Subscrever Newsletter` (decision D10, audit §3.5). The newsletter has no
 * known destination (D18) and no endpoint — Phase 13 built the CONTACT endpoint only, and
 * the newsletter one waits on D18 — so the published invitation is
 * rendered as what it says — an invitation to make contact — and the control goes to
 * /contactos/. A control is rendered only when it controls something (decision A41).
 *
 * No icon cards, no feature grid, no process diagram and no numbered method: the source
 * describes four services and no sequence, and numbering things that are not a sequence
 * is decoration pretending to be information.
 */
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandMark from '../site/BrandMark.astro';
import Reel from '../site/Reel.astro';
import { SERVICES_PAGE, SERVICES_LEAD } from '../../lib/static-pages.ts';
import { PAGE_CONTENT } from '../../lib/page-content.ts';
import { imageProps } from '../../lib/media.ts';
import { navHref } from '../../lib/nav.ts';
import { organizationSchema, breadcrumbSchema, absoluteUrl } from '../../lib/seo.ts';
import type { Locale } from '../../config/i18n.ts';
import { pagePath } from '../../i18n/routes.ts';
import { t } from '../../i18n/index.ts';
import { say } from '../../lib/homepage.ts';
import { pageTitle, pageDescription } from '../../lib/page-meta.ts';
import '../../styles/pages.css';
import '../../styles/sections.css';

interface Props { locale: Locale }
const { locale } = Astro.props;

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const settings = await getEntry('settings', 'site');

/**
 * The page's own photograph, and its own og:image. The original is 624px wide — the
 * whole file — so it takes a column and never the page width. Nothing here is upscaled
 * to fill a layout (decision A76).
 */
const leadKey = PAGE_CONTENT.services.leadImage;
const leadImage = imageProps(leadKey, { alt: '', sizes: '(min-width: 60rem) 39rem, 92vw' });

/** The storyboard's collage: food, sunset, wedding. The middle frame is the large one. */
const collage = PAGE_CONTENT.services.collage
  .map((key, i) => imageProps(key, { alt: '', sizes: i === 1 ? '(min-width: 48rem) 34vw, 60vw' : '(min-width: 48rem) 22vw, 40vw' }));

const schema = [
  organizationSchema({
    sameAs: (settings?.data.socials ?? []).map((s) => s.url),
    email: settings?.data.email ?? null,
  }),
  breadcrumbSchema([
    { name: 'Next Vision Films', path: pagePath('home', locale) },
    { name: say(SERVICES_PAGE.title, locale), path: pagePath('services', locale) },
  ]),
  /**
   * The four services as an ItemList, which is what they are. No `Service` nodes with
   * invented `areaServed`, `provider` or price fields: only what the page publishes.
   */
  {
    '@type': 'ItemList',
    name: say(SERVICES_PAGE.title, locale),
    itemListElement: services.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.data.title[locale] ?? s.data.title.pt,
      description: s.data.description[locale] ?? s.data.description.pt,
    })),
  },
];
---

<BaseLayout
  section="commercial"
  title={pageTitle('services', locale)}
  description={pageDescription('services', locale) ?? undefined}
  locale={locale}
  ground="cream"
  ogType="article"
  ogImage={leadImage ? absoluteUrl(leadImage.src) : null}
  schema={schema}
>
  {/* ── DESIGN V2 (Tatiana) — Commercial ───────────────────────────────────
      The colour NVF, a collage of three frames (food, sunset, wedding — the storyboard's
      own choice, taken from the manifest), and each service set the way the storyboard
      sets VIDEO PRODUCTION: a black headline over its description. All four services and
      the lead are the page's published copy, unchanged. The reel rolls in along the foot
      and comes to rest as LET'S TALK, which is the page's own invitation to /contactos/. */}
  <section class="cm ground-cream" data-ground="cream">
    <BrandMark mark="colour" class="cm__mark" />
    <h1 class="cm__title" id="page-title">{say(SERVICES_PAGE.title, locale)}</h1>

    <div class="cm__collage" aria-hidden="true">
      {collage.map((img, i) => img && (
        <picture class={`cm__frame cm__frame--${i + 1}`}>
          {img.avifSrcset && <source type="image/avif" srcset={img.avifSrcset} sizes={img.sizes} />}
          <img src={img.src} srcset={img.srcset} sizes={img.sizes} alt="" width={img.width} height={img.height} loading={i === 1 ? 'eager' : 'lazy'} decoding="async" />
        </picture>
      ))}
    </div>

    <p class="cm__lead">
      {/* The three marked phrases are the SOURCE's own emphasis, in both languages. */}
      {SERVICES_LEAD.map((seg) => {
        const run = locale === 'en' ? seg.en : seg.text;
        return seg.mark ? <span class="sv-mark">{run}</span> : <>{run}</>;
      })}
    </p>

    <div class="cm__services">
      {services.map((s) => (
        <div class="cm__service">
          <h2>{s.data.title[locale] ?? s.data.title.pt}</h2>
          <p>{s.data.description[locale] ?? s.data.description.pt}</p>
        </div>
      ))}
    </div>

    <div class="cm__close">
      <p class="cm__close-a">{say(SERVICES_PAGE.closeLineA, locale)}</p>
      <h2 class="cm__close-b">{say(SERVICES_PAGE.closeLineB, locale)}</h2>
      <p>{say(SERVICES_PAGE.closeBody, locale)}</p>
    </div>

    <svg class="cm__asterisk" viewBox="-12 -12 24 24" aria-hidden="true"><path d="M0-10V10M-10 0H10M-7-7 7 7M-7 7 7-7" /></svg>
  </section>

  <a class="talk" href={`${navHref('contact', locale)}#contactar`}>
    <i class="talk__film" aria-hidden="true"></i>
    <Reel class="talk__reel" text={["LET'S", 'TALK']} />
    <span class="visually-hidden">{t('ui.letsTalk', locale)}</span>
  </a>
</BaseLayout>
