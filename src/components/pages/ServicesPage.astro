---
/**
 * /servicos/ — PHASE 10.
 *
 * ── Owner request, 2026-10-29: no text, a carousel per category ──────────────
 * The owners asked for the page's text to go and for the work to be shown by category,
 * one carousel each, and only the categories they named. The page is now the mark, its
 * title, those carousels, and LET'S TALK. Which categories appear, and in what order, is
 * data (`categories` in services.json); each carousel is that category's projects in
 * portfolio order, as the same cards the portfolio uses, headed by the category's own
 * published name. The lead, the four services and the closing invitation stay in
 * services.json and the services collection, unrendered and never deleted (CLAUDE.md §2).
 *
 * A carousel is a native horizontal scroller with scroll-snap: touch, trackpad and
 * Shift+wheel move it, and tabbing through its cards scrolls each into view. No script,
 * no autoplay, nothing that takes the page's own scroll.
 */
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandMark from '../site/BrandMark.astro';
import Reel from '../site/Reel.astro';
import ProjectCard from '../site/ProjectCard.astro';
import { SERVICES_PAGE } from '../../lib/static-pages.ts';
import { PAGE_CONTENT } from '../../lib/page-content.ts';
import { imageProps } from '../../lib/media.ts';
import { navHref } from '../../lib/nav.ts';
import { portfolioProjects } from '../../lib/curated.ts';
import { FILTERED_RATIO } from '../../lib/portfolio.ts';
import { organizationSchema, breadcrumbSchema, absoluteUrl } from '../../lib/seo.ts';
import type { Locale } from '../../config/i18n.ts';
import { pagePath } from '../../i18n/routes.ts';
import { t } from '../../i18n/index.ts';
import { say } from '../../lib/homepage.ts';
import { pageTitle, pageDescription } from '../../lib/page-meta.ts';
import '../../styles/pages.css';
import '../../styles/sections.css';

interface Props { locale: Locale }
const { locale } = Astro.props;

const settings = await getEntry('settings', 'site');

/** The page's og:image. It is no longer shown on the page itself. */
const leadImage = imageProps(PAGE_CONTENT.services.leadImage, { alt: '' });

/**
 * One carousel per category the data names. A slug that names no visible category fails
 * the build rather than shipping an empty heading. A project counts in every category it
 * carries, not only its first.
 */
const projects = await portfolioProjects(locale);
const inCategory = new Map((await getCollection('projects')).map((p) => [p.id, new Set(p.data.categories.map((c) => c.id))]));
const carousels = await Promise.all(PAGE_CONTENT.services.categories.map(async (slug) => {
  const cat = await getEntry('categories', slug);
  if (!cat || cat.data.hidden) throw new Error(`services.json categories: "${slug}" is not a visible category`);
  return {
    slug,
    name: cat.data.name[locale] ?? cat.data.name.pt,
    projects: projects.filter((p) => inCategory.get(p.slug)?.has(slug)),
  };
}));

const schema = [
  organizationSchema({
    sameAs: (settings?.data.socials ?? []).map((s) => s.url),
    email: settings?.data.email ?? null,
  }),
  breadcrumbSchema([
    { name: 'Next Vision Films', path: pagePath('home', locale) },
    { name: say(SERVICES_PAGE.title, locale), path: pagePath('services', locale) },
  ]),
];
---

<BaseLayout
  section="commercial"
  title={pageTitle('services', locale)}
  description={pageDescription('services', locale) ?? undefined}
  locale={locale}
  ground="cream"
  ogType="article"
  ogImage={leadImage ? absoluteUrl(leadImage.src) : null}
  schema={schema}
>
  {/* ── DESIGN V2 (Tatiana) — Commercial ───────────────────────────────────
      The colour NVF, the page title, and a carousel of films per category. The reel rolls
      in along the foot and comes to rest as LET'S TALK, the page's own invitation to
      /contactos/. */}
  <section class="cm ground-cream" data-ground="cream">
    <BrandMark mark="colour" class="cm__mark" />
    <h1 class="cm__title" id="page-title">{say(SERVICES_PAGE.title, locale)}</h1>

    <div class="cm__rows">
      {carousels.map(({ slug, name, projects }) => projects.length > 0 && (
        <section class="cm__row" aria-labelledby={`cm-${slug}`}>
          <h2 class="cm__row-title" id={`cm-${slug}`}>{name}</h2>
          <div class="cm__track">
            {projects.map((p) => (
              <ProjectCard
                project={p}
                ratio={FILTERED_RATIO}
                tabletRatio={FILTERED_RATIO}
                mobileRatio={FILTERED_RATIO}
                sizes="(min-width: 34rem) 24rem, 80vw"
                locale={locale}
              />
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>

  <a class="talk" href={`${navHref('contact', locale)}#contactar`}>
    <i class="talk__film" aria-hidden="true"></i>
    <Reel class="talk__reel" text={["LET'S", 'TALK']} />
    <span class="visually-hidden">{t('ui.letsTalk', locale)}</span>
  </a>
</BaseLayout>
