---
/**
 * Direction A — PROJECTION. Review A prototype. INTERNAL, noindex.
 *
 * All copy and media are real and preserved. Nothing invented.
 */
import ConceptLayout from '../../layouts/ConceptLayout.astro';
import { projects, copy, heroFilm, bySlug } from '../../lib/concept-data.ts';
import '../../styles/concepts/projection.css';

// A representative selection, not the whole catalogue — Review A is about visual
// storytelling, and the owners dislike excessive text.
const featured = ['nvf-vs-filmin-details', 'leonor', 'helder-praia', 'nazaryi', 'nvf-vs-antiqvvm', 'the-end']
  .map((s) => bySlug(s)!)
  .filter(Boolean);

const bleed = bySlug('helder-praia')!;
const total = projects.length;
---

<ConceptLayout concept="projection" title="Projection" lerp={0.075}>
  <header class="c-header">
    <a class="c-header__brand" href="/__concepts/">Next Vision Films</a>
    <nav class="c-header__nav" data-menu aria-label="Principal">
      <a href="#work">{copy.nav.portfolio}</a>
      <a href="#about">{copy.nav.about}</a>
      <a href="#contact">{copy.nav.contact}</a>
    </nav>
    <button class="c-menu-toggle" data-menu-toggle aria-expanded="false" aria-controls="menu">Menu</button>
  </header>

  <main class="c-main">
    <!-- 1 · HERO — footage as ground, text on paper in front of it -->
    <section class="p-hero" aria-labelledby="hero-title">
      <div class="p-hero__media">
        <video
          src={heroFilm.src}
          poster={heroFilm.poster}
          autoplay muted loop playsinline
          aria-hidden="true"
        ></video>
      </div>

      <div class="p-card" data-reveal>
        <p class="c-meta p-card__kicker">Produtora audiovisual — Portugal</p>
        <h1 class="c-display p-card__title" id="hero-title">
          <span class="c-lines">
            <span><span>{copy.heroLine1}</span></span>
            <span><span style="--line-delay:90ms">{copy.heroLine2}</span></span>
          </span>
        </h1>
        <div class="c-stripe" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
      </div>

      <button class="p-sound" type="button" data-sound aria-pressed="false">
        <span aria-hidden="true">◼</span> Som
      </button>
    </section>

    <!-- 2 · WORK — titles are the interface; the still changes behind them -->
    <section class="c-section p-work" id="work" aria-labelledby="work-title">
      <div class="c-wide">
        <p class="c-meta" style="margin-block-end:var(--space-6)">
          Trabalho selecionado — {String(featured.length).padStart(2, '0')} de {total}
        </p>
        <h2 class="c-display c-display--m" id="work-title" style="position:absolute;inline-size:1px;block-size:1px;overflow:hidden;clip-path:inset(50%)">
          {copy.workLine1} {copy.workLine2}
        </h2>

        <div class="p-work__stage" aria-hidden="true">
          {featured.map((p) => (
            <img class="p-work__still" data-still={p.slug} src={p.poster} alt="" loading="lazy" decoding="async" width="1200" height="675" />
          ))}
        </div>

        <div class="p-work__list" data-work-list>
          {featured.map((p) => (
            <a class={`c-link p-row cat-${p.categoryToken}`} href="#work" data-row={p.slug} data-reveal>
              <span class="p-row__dot" aria-hidden="true"></span>
              <span class="p-row__title">{p.title}</span>
              <span class="c-meta p-row__meta">{p.category} · {p.date}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 3 · IDENTITY — the paper panel, inverted -->
    <section class="c-section p-panel" id="about" aria-labelledby="about-title">
      <div class="c-content">
        <p class="c-meta" style="margin-block-end:var(--space-5)">Sobre</p>
        <h2 class="c-display c-display--l" id="about-title" data-reveal>
          <span class="c-lines">
            <span><span>{copy.workLine1}</span></span>
            <span><span style="--line-delay:90ms">{copy.workLine2}</span></span>
          </span>
        </h2>
        <p class="c-lead" style="margin-block-start:var(--space-6)" data-reveal>{copy.workBody}</p>
        <p class="c-body" style="margin-block-start:var(--space-4);opacity:.7" data-reveal>{copy.workBody2}</p>
      </div>
    </section>

    <!-- 4 · TRANSITION into another film — a held frame with its own words -->
    <section class="p-bleed" aria-label={bleed.title}>
      <video
        src={bleed.preview} poster={bleed.poster}
        autoplay muted loop playsinline aria-hidden="true"
      ></video>
      <blockquote class="p-bleed__quote" data-reveal>
        {bleed.tagline?.split('. ')[0]}.
        <footer class="c-meta" style="margin-block-start:var(--space-5);opacity:.75">
          {bleed.title} — {bleed.category}
        </footer>
      </blockquote>
    </section>

    <!-- 5 · CLOSE -->
    <section class="c-section p-footer" id="contact">
      <div class="c-wide">
        <div class="c-stripe" style="--stripe-h:2px;margin-block-end:var(--space-7)" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        <p class="c-meta" style="opacity:.6">{copy.footerTitle}</p>
        <a class="p-footer__email" href={`mailto:${copy.footerEmail}`}>{copy.footerEmail}</a>
        <p class="c-meta" style="margin-block-start:var(--space-7);opacity:.45">{copy.copyright}</p>
      </div>
    </section>
  </main>

  <script>
    // Concept-specific behaviour only. Shared runtime lives in lib/concept-motion.ts.
    const rows = document.querySelectorAll<HTMLElement>('[data-row]');
    const stills = document.querySelectorAll<HTMLElement>('[data-still]');
    const show = (slug: string | null) => {
      stills.forEach((s) => {
        if (s.dataset['still'] === slug) s.dataset['active'] = '';
        else delete s.dataset['active'];
      });
    };
    // Pointer AND focus, so keyboard users get the same reveal.
    rows.forEach((row) => {
      const slug = row.dataset['row'] ?? null;
      row.addEventListener('pointerenter', () => show(slug));
      row.addEventListener('focusin', () => show(slug));
      row.addEventListener('pointerleave', () => show(null));
      row.addEventListener('focusout', () => show(null));
    });

    // Sound is opt-in, and the control reports its own state.
    const btn = document.querySelector<HTMLButtonElement>('[data-sound]');
    const hero = document.querySelector<HTMLVideoElement>('.p-hero__media video');
    btn?.addEventListener('click', () => {
      if (!hero) return;
      hero.muted = !hero.muted;
      btn.setAttribute('aria-pressed', String(!hero.muted));
      btn.innerHTML = hero.muted ? '<span aria-hidden="true">◼</span> Som' : '<span aria-hidden="true">◆</span> Som ligado';
    });
  </script>
</ConceptLayout>
