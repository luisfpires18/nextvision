---
/**
 * One page's editable fields as a form (phase A2, slice 1).
 *
 * Text: Portuguese and English side by side, always both, with where the words came from.
 * Media: a list of the footage already on the site, of the right kind only (a still where
 * a still goes, a film with a poster where the opening film goes), with the picture shown.
 * Locked fields are shown with the reason, and have no input at all, so the form cannot
 * post them.
 *
 * There is no Save: every change is a draft kept in the browser the moment it is typed,
 * and one Publicar sends the drafts from every page together (A10, admin-client.ts).
 */
import { allMedia, getMedia, renditions } from '../lib/media.ts';
import { fieldName, getAt, type Field, type Published } from '../lib/admin/edit.ts';
import { SCREEN_LABELS, type PageFileName } from '../lib/admin/fields.ts';
import { MAX_LOOP_S, MIN_LOOP_S, type UploadEntry } from '../lib/admin/uploads.ts';

interface Props {
  screen: PageFileName;
  fields: Field[];
  docs: Partial<Record<PageFileName, unknown>>;
  /** This screen's upload requests on `dev` (A4), newest first. */
  uploads: UploadEntry[];
}
const { screen, fields, docs, uploads } = Astro.props;
/** How a draft names itself in the Publicar list, from any page. */
const named = (f: Field, lang?: string) => `${SCREEN_LABELS[screen]} — ${f.label}${lang ? ` (${lang})` : ''}`;

const when = (iso: string) => new Date(iso).toLocaleString('pt-PT', { dateStyle: 'short', timeStyle: 'short', timeZone: 'Europe/Lisbon' });
/** A field's requests worth showing: still processing, or failed in the last week. */
const requestsFor = (f: Field) => uploads.filter((u) => u.target.file === f.file && u.target.path === f.key
  && (u.status === 'pending' || (u.status === 'failed' && Date.now() - Date.parse(u.at) < 7 * 86_400_000))).slice(0, 3);

const thumb = (key: string): string => {
  const item = getMedia(key);
  const still = item?.kind === 'video' ? `${key}/poster` : key;
  return renditions(still, 'webp')[0]?.src ?? '';
};

/** The candidates for each kind, grouped by where they come from (`projects/leonor`). */
const options = (kind: 'image' | 'video') => {
  // A video's own poster (`…/hero/poster`) belongs to that video, not to the image list.
  // A project's poster (`projects/x/poster`) is a still like any other and stays in.
  const isVideoPoster = (key: string) => key.endsWith('/poster') && getMedia(key.slice(0, -'/poster'.length))?.kind === 'video';
  const items = allMedia().filter((m) => (kind === 'image'
    ? m.kind === 'image' && !isVideoPoster(m.key)
    : m.kind === 'video' && getMedia(`${m.key}/poster`) !== null));
  const groups = new Map<string, string[]>();
  for (const m of items) {
    const parts = m.key.split('/');
    const group = parts.slice(0, 2).join('/');
    groups.set(group, [...(groups.get(group) ?? []), m.key]);
  }
  return [...groups].sort(([a], [b]) => a.localeCompare(b));
};
const MEDIA = { image: options('image'), video: options('video') };

const source = (from: string) => from.startsWith('owner:')
  ? `Alterado no admin em ${new Date(from.slice(6)).toLocaleDateString('pt-PT', { dateStyle: 'long' })}`
  : `Texto original do site, publicado em ${from === '/' ? 'a página inicial' : from}`;
---

<form class="admin-editor" data-editor data-screen={screen} novalidate>
  {fields.map((f) => {
    const value = getAt(docs[f.file], f.key);
    if (f.kind === 'text') {
      const p = value as Published;
      return (
        <fieldset class="ed-field" data-field>
          <legend>{f.label}</legend>
          {f.note ? <p class="ed-note">{f.note}</p> : null}
          {f.locked ? (
            <>
              <div class="f-pair">
                <p lang="pt-PT"><span class="f-lang">PT</span>{p.text}</p>
                <p lang="en"><span class="f-lang">EN</span>{p.en}</p>
              </div>
              <p class="admin-locked">{f.locked}</p>
            </>
          ) : (
            <>
              <div class="ed-pair">
                <label>
                  <span class="f-lang">Português</span>
                  <textarea name={fieldName(f, 'pt')} data-original={p.text} data-label={named(f, 'PT')} rows={Math.min(8, Math.ceil(p.text.length / 60) + 1)} lang="pt-PT" required>{p.text}</textarea>
                </label>
                <label>
                  <span class="f-lang">Inglês</span>
                  <textarea name={fieldName(f, 'en')} data-original={p.en ?? ''} data-label={named(f, 'EN')} rows={Math.min(8, Math.ceil((p.en ?? '').length / 60) + 1)} lang="en" required>{p.en ?? ''}</textarea>
                </label>
              </div>
              <p class="ed-source">{source(p.from)}</p>
            </>
          )}
        </fieldset>
      );
    }
    const key = String(value ?? '');
    const kind = f.kind === 'video' ? 'video' : 'image';
    const id = `pick-${f.file}-${f.key.replace(/\W/g, '-')}`;
    return (
      <fieldset class="ed-field ed-media" data-field>
        <legend>{f.label}</legend>
        {f.note ? <p class="ed-note">{f.note}</p> : null}
        <div class="ed-media__row">
          <img src={thumb(key)} alt="" data-preview-for={id} width="160" height="90" />
          <label class="ed-media__pick">
            <span class="f-lang">{kind === 'video' ? 'Vídeo' : 'Imagem'}</span>
            <select id={id} name={fieldName(f)} data-original={key} data-label={named(f)}>
              {/* The current value is ALWAYS an option: a missing one would make the browser
                  pick the first entry, and Save would silently replace the picture. */}
              {key && !MEDIA[kind].some(([, keys]) => keys.includes(key)) ? (
                <option value={key} data-thumb={thumb(key)} selected>{key} (atual)</option>
              ) : null}
              {MEDIA[kind].map(([group, keys]) => (
                <optgroup label={group}>
                  {keys.map((k) => <option value={k} data-thumb={thumb(k)} selected={k === key}>{k.split('/').slice(1).join(' / ')}</option>)}
                </optgroup>
              ))}
            </select>
          </label>
        </div>

        {requestsFor(f).map((u) => (
          <p class="ed-request" data-request={u.id} data-status={u.status}>
            {u.status === 'pending'
              ? `A processar «${u.name}» (pedido ${when(u.at)}). Vai para o site sozinho quando terminar.`
              : `Não foi possível usar «${u.name}»: ${u.error ?? 'erro desconhecido.'}`}
          </p>
        ))}

        <details class="ed-upload" data-upload data-target={`${f.file}:${f.key}`} data-kind={kind}
          data-min={MIN_LOOP_S} data-max={MAX_LOOP_S}>
          <summary>Carregar novo ficheiro…</summary>
          <label class="ed-upload__file">
            <span class="f-lang">{kind === 'video' ? 'Vídeo (MP4, MOV ou WebM, até 2 GB)' : 'Imagem (JPG, PNG, WebP ou TIFF, até 2 GB)'}</span>
            <input type="file" data-upload-file
              accept={kind === 'video' ? 'video/mp4,video/quicktime,video/webm,.mp4,.m4v,.mov,.webm' : 'image/jpeg,image/png,image/webp,image/tiff,.jpg,.jpeg,.png,.webp,.tif,.tiff'} />
          </label>
          {kind === 'video' ? (
            <div class="ed-window" data-window hidden>
              <video controls muted playsinline preload="metadata" data-upload-video></video>
              <p class="ed-note" data-video-note>Ponha o vídeo no momento certo e marque. O excerto repete-se em silêncio no site, por isso escolha {MIN_LOOP_S} a {MAX_LOOP_S} segundos sem texto por cima nem cartões finais.</p>
              <div class="ed-marks">
                <button type="button" data-mark="start">Início aqui</button>
                <label><span class="f-lang">Início (s)</span><input type="number" min="0" step="0.1" data-time="start" /></label>
                <button type="button" data-mark="end">Fim aqui</button>
                <label><span class="f-lang">Fim (s)</span><input type="number" min="0" step="0.1" data-time="end" /></label>
                <button type="button" data-mark="poster">Capa aqui</button>
                <label><span class="f-lang">Capa (s)</span><input type="number" min="0" step="0.1" data-time="poster" /></label>
              </div>
              <label class="ed-upload__file">
                <span class="f-lang">O que este excerto evita (opcional)</span>
                <input type="text" maxlength="300" data-upload-note placeholder="ex.: sem legendas e sem o logótipo do cliente" />
              </label>
            </div>
          ) : null}
          <div class="ed-upload__go">
            <button type="button" class="ed-save" data-upload-go disabled>Carregar e publicar</button>
            <progress max="100" value="0" data-upload-progress hidden></progress>
          </div>
          <p class="ed-message" role="status" aria-live="polite" data-upload-message></p>
        </details>
      </fieldset>
    );
  })}

  <p class="ed-message" role="status" aria-live="polite" data-message></p>
</form>
