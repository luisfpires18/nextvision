---
/**
 * One page's editable fields as a form (phase A2, slice 1).
 *
 * Text: Portuguese and English side by side, always both, with where the words came from.
 * Media: a list of the footage already on the site, of the right kind only (a still where
 * a still goes, a film with a poster where the opening film goes), with the picture shown.
 * Locked fields are shown with the reason, and have no input at all, so the form cannot
 * post them.
 *
 * There is no Save: every change is a draft kept in the browser the moment it is typed,
 * and one Publicar sends the drafts from every page together (A10, admin-client.ts).
 */
import { MEDIA, thumb } from './media-options.ts';
import UploadPanel from './UploadPanel.astro';
import { fieldName, getAt, type Field, type Published } from '../lib/admin/edit.ts';
import { SCREEN_LABELS, type PageFileName } from '../lib/admin/fields.ts';
import { requestsFor, type UploadEntry } from '../lib/admin/uploads.ts';

interface Props {
  screen: PageFileName;
  fields: Field[];
  docs: Partial<Record<PageFileName, unknown>>;
  /** This screen's upload requests on `dev` (A4), newest first. */
  uploads: UploadEntry[];
}
const { screen, fields, docs, uploads } = Astro.props;
/** How a draft names itself in the Publicar list, from any page. */
const named = (f: Field, lang?: string) => `${SCREEN_LABELS[screen]} — ${f.label}${lang ? ` (${lang})` : ''}`;



const source = (from: string) => from.startsWith('owner:')
  ? `Alterado no admin em ${new Date(from.slice(6)).toLocaleDateString('pt-PT', { dateStyle: 'long' })}`
  : `Texto original do site, publicado em ${from === '/' ? 'a página inicial' : from}`;
---

<form class="admin-editor" data-editor data-screen={screen} novalidate>
  {fields.map((f) => {
    const value = getAt(docs[f.file], f.key);
    if (f.kind === 'text') {
      const p = value as Published;
      return (
        <fieldset class="ed-field" data-field>
          <legend>{f.label}</legend>
          {f.note ? <p class="ed-note">{f.note}</p> : null}
          {f.locked ? (
            <>
              <div class="f-pair">
                <p lang="pt-PT"><span class="f-lang">PT</span>{p.text}</p>
                <p lang="en"><span class="f-lang">EN</span>{p.en}</p>
              </div>
              <p class="admin-locked">{f.locked}</p>
            </>
          ) : (
            <>
              <div class="ed-pair">
                <label>
                  <span class="f-lang">Português</span>
                  <textarea name={fieldName(f, 'pt')} data-original={p.text} data-label={named(f, 'PT')} rows={Math.min(8, Math.ceil(p.text.length / 60) + 1)} lang="pt-PT" required>{p.text}</textarea>
                </label>
                <label>
                  <span class="f-lang">Inglês</span>
                  <textarea name={fieldName(f, 'en')} data-original={p.en ?? ''} data-label={named(f, 'EN')} rows={Math.min(8, Math.ceil((p.en ?? '').length / 60) + 1)} lang="en" required>{p.en ?? ''}</textarea>
                </label>
              </div>
              <p class="ed-source">{source(p.from)}</p>
            </>
          )}
        </fieldset>
      );
    }
    const key = String(value ?? '');
    const kind = f.kind === 'video' ? 'video' : 'image';
    const id = `pick-${f.file}-${f.key.replace(/\W/g, '-')}`;
    return (
      <fieldset class="ed-field ed-media" data-field>
        <legend>{f.label}</legend>
        {f.note ? <p class="ed-note">{f.note}</p> : null}
        <div class="ed-media__row">
          <img src={thumb(key)} alt="" data-preview-for={id} width="160" height="90" />
          <label class="ed-media__pick">
            <span class="f-lang">{kind === 'video' ? 'Vídeo' : 'Imagem'}</span>
            <select id={id} name={fieldName(f)} data-original={key} data-label={named(f)}>
              {/* The current value is ALWAYS an option: a missing one would make the browser
                  pick the first entry, and Save would silently replace the picture. */}
              {key && !MEDIA[kind].some(([, keys]) => keys.includes(key)) ? (
                <option value={key} data-thumb={thumb(key)} selected>{key} (atual)</option>
              ) : null}
              {MEDIA[kind].map(([group, keys]) => (
                <optgroup label={group}>
                  {keys.map((k) => <option value={k} data-thumb={thumb(k)} selected={k === key}>{k.split('/').slice(1).join(' / ')}</option>)}
                </optgroup>
              ))}
            </select>
          </label>
        </div>

        <UploadPanel target={`${f.file}:${f.key}`} kind={kind} requests={requestsFor(uploads, f.file, f.key)} />
      </fieldset>
    );
  })}

  <p class="ed-message" role="status" aria-live="polite" data-message></p>
</form>
