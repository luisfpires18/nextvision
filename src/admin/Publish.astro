---
/**
 * /admin/publicar/ — what is waiting to go live, and the button that sends it (phase A3).
 *
 * Everything shown is read from GitHub as the page loads: what `dev` has that `master`
 * does not, whether all of it is owner content, and whether the preview of exactly that
 * state has built. The button carries the commit it was shown for; the server re-checks
 * everything (src/admin/api/publish.ts), so a stale page can never publish more than it
 * listed.
 */
import type { Assessment } from '../lib/admin/publish.ts';
import { PREVIEW_URL } from '../config/site.ts';
import { IS_DEV } from '../lib/forms/env.ts';

interface Props {
  waiting: Assessment | null;
  head: string | null;
  preview: 'ready' | 'building' | 'failed' | 'none';
  notice: string | null;
}
const { waiting, head, preview, notice } = Astro.props;

const when = (iso: string) => new Date(iso).toLocaleString('pt-PT', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Europe/Lisbon' });
const n = waiting?.items.length ?? 0;
const ready = !!waiting && n > 0 && !waiting.blocked.length && preview === 'ready';
const previewHref = IS_DEV ? '/' : `${PREVIEW_URL}/`;
---

<main class="admin-overview admin-publish" data-section="contact">
  <h1>Publicar no site</h1>

  {notice ? <p class="admin-locked">{notice}</p> : null}

  {waiting && n === 0 && !waiting.blocked.length ? (
    <p class="admin-lede">Não há nada por publicar. Tudo o que foi guardado já está no site.</p>
  ) : null}

  {waiting && n > 0 ? (
    <>
      <p class="admin-lede">
        {n === 1 ? 'Esta alteração foi guardada e ainda não está' : `Estas ${n} alterações foram guardadas e ainda não estão`} no site público.
        Confira-as na <a href={previewHref} target="_blank" rel="noopener">pré-visualização</a> antes de publicar.
      </p>
      <ol class="pub-list">
        {waiting.items.map((i) => (
          <li>
            <span class="pub-page">{i.page}</span>
            <span class="pub-fields">{i.fields}</span>
            <span class="pub-meta">{when(i.date)}{i.by ? ` · ${i.by}` : ''}</span>
          </li>
        ))}
      </ol>
    </>
  ) : null}

  {waiting?.blocked.length ? (
    <div class="admin-locked">
      <p><strong>Não é possível publicar agora.</strong></p>
      {waiting.blocked.map((b) => <p>{b}</p>)}
      <p>Publicar envia tudo o que está à espera, por isso fica bloqueado até o programador rever. Fale com ele.</p>
    </div>
  ) : null}

  {waiting && n > 0 && !waiting.blocked.length && preview !== 'ready' ? (
    <p class="admin-locked">
      {preview === 'failed'
        ? 'A pré-visualização destas alterações falhou, por isso não podem ser publicadas. Fale com o programador.'
        : 'A pré-visualização destas alterações ainda está a ser preparada. Recarregue esta página daqui a pouco.'}
    </p>
  ) : null}

  {ready ? (
    <div class="pub-actions" data-publish data-reviewed={head}>
      <button type="button" class="ed-save" data-publish-start>Publicar no site</button>
      <div class="pub-confirm" data-publish-confirm hidden>
        <p>Isto põe {n === 1 ? 'esta alteração' : `estas ${n} alterações`} no site público, <strong>nextvisionfilms.com</strong>. Confirma?</p>
        <button type="button" class="ed-save" data-publish-go>Sim, publicar</button>
        <button type="button" class="pub-cancel" data-publish-cancel>Cancelar</button>
      </div>
      <p class="ed-message" role="status" aria-live="polite" data-publish-message></p>
    </div>
  ) : null}
</main>
