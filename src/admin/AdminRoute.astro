---
/**
 * /admin/ — the owners' content browser. Phase A1: READ-ONLY.
 *
 * Injected only into the prod Worker's build (astro.config.mjs, `nvf:admin`), behind
 * Cloudflare Access, and verified again here on every request (src/lib/admin/guard.ts).
 *
 * The layout is docs/ADMIN_REDESIGN_PLAN.md (2026-11-07): the sections down the left, each
 * section one page of tabs and card grids, and an item opened in a modal over its grid.
 *
 *   /admin/                          every section and how many items it holds
 *   /admin/<area>/                   that section's items
 *   /admin/<area>/?g=<group>         that section, one tab open
 *   /admin/<area>/<group>/<item>/    the same page, that item open in the edit modal
 */
export const prerender = false;

import { ICON } from './icons.ts';
import '../styles/tokens.colour.css';
import '../styles/tokens.type.css';
import '../styles/tokens.space.css';
import '../styles/tokens.motion.css';
import '../styles/fonts.css';
import '../styles/admin.css';
import Field from './Field.astro';
import ItemCard from './ItemCard.astro';
import Editor from './Editor.astro';
import ProjectEditor from './ProjectEditor.astro';
import OrderEditor from './OrderEditor.astro';
import NewProject from './NewProject.astro';
import EntryEditor from './EntryEditor.astro';
import { ENTRY_TYPES, entryData, entryDraftFile, entryFilePath, type EntryType } from '../lib/admin/entries.ts';
import { getCollection } from 'astro:content';
import { PROJECTS_DIR, portfolioSequence, projectData, projectDraftFile, projectFilePath, projectValue } from '../lib/admin/projects.ts';
import { githubConfig } from '../lib/admin/repo.ts';
import { listFiles, readFile } from '../lib/admin/github.ts';
import { UPLOADS_PATH, type UploadsDoc, type UploadEntry } from '../lib/admin/uploads.ts';
import { SCREENS, pageFilePath, type PageFileName } from '../lib/admin/fields.ts';
import { expandFields, type Field as EditField } from '../lib/admin/edit.ts';
import { adminIdentity, LOGOUT_PATH } from '../lib/admin/guard.ts';
import { AREAS, findArea, type AdminItem } from '../lib/admin/content.ts';
const HEADERS = {
  'Cache-Control': 'no-store',
  'X-Robots-Tag': 'noindex, nofollow',
  'X-Frame-Options': 'DENY',
  'Referrer-Policy': 'same-origin',
};

// A body sent to a page is never used, but refusing with it unread breaks wrangler's local
// proxy on the next request (measured, step A2). Drain it first.
if (Astro.request.method !== 'GET' && Astro.request.method !== 'HEAD') await Astro.request.arrayBuffer().catch(() => undefined);

const who = await adminIdentity(Astro.request);
if (!who) {
  return new Response('Sem acesso. Entre através do link de acesso enviado para o email autorizado.', {
    status: 403,
    headers: { ...HEADERS, 'Content-Type': 'text/plain; charset=utf-8' },
  });
}
for (const [k, v] of Object.entries(HEADERS)) Astro.response.headers.set(k, v);

const [areaId, groupId, itemId, extra] = (Astro.params['path'] ?? '').split('/').filter(Boolean);
const area = areaId ? findArea(areaId) : null;
if (extra || (areaId && !area) || (groupId && !itemId)) {
  return new Response('Não encontrado.', { status: 404, headers: { ...HEADERS, 'Content-Type': 'text/plain; charset=utf-8' } });
}

/* Every group's items, loaded once: the overview needs counts, an area needs its list. */
const loaded = await Promise.all(AREAS.map(async (a) => ({
  area: a,
  groups: await Promise.all(a.groups.map(async (g) => ({ group: g, items: await g.load() }))),
})));
const current = loaded.find((l) => l.area === area) ?? null;

let item: AdminItem | null = null;
if (current && groupId) {
  item = current.groups.find((g) => g.group.id === groupId)?.items.find((i) => i.id === itemId) ?? null;
  if (!item) {
    return new Response('Não encontrado.', { status: 404, headers: { ...HEADERS, 'Content-Type': 'text/plain; charset=utf-8' } });
  }
}

/**
 * A page screen is editable. It is edited from the files as they are on `master` NOW,
 * read from GitHub — not from this build, which may be a few minutes behind a publish.
 * Edits are kept as drafts in the browser until Publicar (A10, admin-client.ts).
 */
const screen = item && groupId?.startsWith('pagina-') && item.id in SCREENS ? (item.id as PageFileName) : null;
let editor: { fields: EditField[]; docs: Partial<Record<PageFileName, unknown>>; uploads: UploadEntry[] } | null = null;
let editorNotice: string | null = null;
if (screen) {
  const cfg = githubConfig();
  if (!cfg) editorNotice = 'Publicar ainda não está configurado neste servidor. Pode consultar, mas não alterar.';
  else {
    try {
      const docs: Partial<Record<PageFileName, unknown>> = {};
      for (const file of new Set(SCREENS[screen].map((d) => d.file))) {
        docs[file] = JSON.parse((await readFile(cfg, pageFilePath(file))).text);
      }
      // This screen's upload requests (A4). A missing list is just none yet.
      const all = await readFile(cfg, UPLOADS_PATH).then((f) => (JSON.parse(f.text) as UploadsDoc).uploads).catch(() => []);
      const uploads = all.filter((u) => u.target.screen === screen).reverse();
      editor = { fields: expandFields(SCREENS[screen], docs), docs, uploads };
    } catch {
      editorNotice = 'Não foi possível ler a versão atual a partir do GitHub. Pode consultar; tente editar daqui a pouco.';
    }
  }
}

/** A project is editable the same way, from its file on `master` now. */
let projectEditor: { slug: string; data: Record<string, unknown>; categories: { id: string; name: string }[]; uploads: UploadEntry[] } | null = null;
if (item && groupId === 'projetos') {
  const cfg = githubConfig();
  if (!cfg) editorNotice = 'Publicar ainda não está configurado neste servidor. Pode consultar, mas não alterar.';
  else {
    try {
      const data = projectData((await readFile(cfg, projectFilePath(item.id))).text);
      const categories = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order).map((c) => ({ id: c.id, name: c.data.name.pt }));
      const all = await readFile(cfg, UPLOADS_PATH).then((f) => (JSON.parse(f.text) as UploadsDoc).uploads).catch(() => []);
      projectEditor = { slug: item.id, data, categories, uploads: all.filter((u) => u.target.file === projectDraftFile(item!.id)).reverse() };
    } catch {
      editorNotice = 'Não foi possível ler a versão atual a partir do GitHub. Pode consultar; tente editar daqui a pouco.';
    }
  }
}

/** The portfolio order, from every project file on `master` now. */
let orderEditor: { slug: string; title: string; poster: string; hidden: boolean }[] | null = null;
if (item && groupId === 'ordem') {
  const cfg = githubConfig();
  if (!cfg) editorNotice = 'Publicar ainda não está configurado neste servidor. Pode consultar, mas não alterar.';
  else {
    try {
      const slugs = (await listFiles(cfg, PROJECTS_DIR)).filter((p) => p.endsWith('.mdx')).map((p) => p.slice(PROJECTS_DIR.length + 1, -'.mdx'.length));
      const files = await Promise.all(slugs.map(async (slug) => ({ slug, text: (await readFile(cfg, projectFilePath(slug))).text })));
      const bySlug = new Map(files.map((f) => [f.slug, projectData(f.text)]));
      orderEditor = portfolioSequence(files).map((slug) => {
        const d = bySlug.get(slug)!;
        return { slug, title: projectValue(d, 'title.pt'), poster: projectValue(d, 'poster.key'), hidden: d['draft'] === true };
      });
    } catch {
      editorNotice = 'Não foi possível ler a versão atual a partir do GitHub. Pode consultar; tente editar daqui a pouco.';
    }
  }
}

/** A new project: the categories it may be filed under. Nothing is read from GitHub yet. */
const newProject = item && groupId === 'novo'
  ? (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order).map((c) => ({ id: c.id, name: c.data.name.pt }))
  : null;

/** Services, team, categories and contacts: which entry type each group of the bin holds. */
const ENTRY_GROUPS: Record<string, EntryType> = {
  servicos: ENTRY_TYPES['servico']!, equipa: ENTRY_TYPES['equipa']!, categorias: ENTRY_TYPES['categoria']!, site: ENTRY_TYPES['definicoes']!,
};
let entryEditor: { type: EntryType; id: string; data: Record<string, unknown>; uploads: UploadEntry[] } | null = null;
const entryType = item && groupId ? ENTRY_GROUPS[groupId] : undefined;

/** Whether a row of the bin opens a form (it gets the pencil) or is only shown. */
const editable = (gid: string, i: { id: string; locked?: string | undefined }) => !i.locked && (
  (gid.startsWith('pagina-') && (SCREENS[i.id as PageFileName]?.length ?? 0) > 0)
  || gid in ENTRY_GROUPS || gid === 'projetos' || gid === 'ordem');
/** Groups that are a button, not a list: "Novo projeto" is the plus on Projetos. */
const ADD_TO: Record<string, string> = { projetos: 'novo' };
if (item && entryType) {
  const cfg = githubConfig();
  if (!cfg) editorNotice = 'Publicar ainda não está configurado neste servidor. Pode consultar, mas não alterar.';
  else {
    try {
      const data = entryData(entryType, (await readFile(cfg, entryFilePath(entryType, item.id))).text);
      const all = await readFile(cfg, UPLOADS_PATH).then((f) => (JSON.parse(f.text) as UploadsDoc).uploads).catch(() => []);
      entryEditor = { type: entryType, id: item.id, data, uploads: all.filter((u) => u.target.file === entryDraftFile(entryType, item!.id)).reverse() };
    } catch {
      editorNotice = 'Não foi possível ler a versão atual a partir do GitHub. Pode consultar; tente editar daqui a pouco.';
    }
  }
}

const href = (...parts: string[]) => `/admin/${parts.map(encodeURIComponent).join('/')}${parts.length ? '/' : ''}`;

/* ── the section page (docs/ADMIN_REDESIGN_PLAN.md §3–§4) ────────────────────
   Each section is one page: a tab per kind of item, each tab a grid of cards. "Novo
   projeto" and "Ordem" are not tabs: they are the + in the header and "Mudar a ordem". */
const ACTION_GROUPS = new Set(['novo', 'ordem']);
/*
 * The tabs. A collection (projects, team, services, categories) is a tab of its own. The
 * single items (a page, the contacts) and the locked ones share one tab, "Páginas" (or
 * "Geral" in Definições), so a section is never a row of tabs holding one card each. An
 * empty group nobody can add to (Coleções, Testemunhos) is not offered at all.
 */
interface Tab { id: string; label: string; entries: { item: AdminItem; gid: string }[] }
const MERGED = 'paginas';
/** Search earns its place only on a tab with more than this many cards. */
const SEARCH_FROM = 6;
const tabs: Tab[] = [];
if (current) {
  const merged: Tab['entries'] = [];
  for (const { group, items } of current.groups) {
    if (ACTION_GROUPS.has(group.id) || (items.length === 0 && !ADD_TO[group.id])) continue;
    const single = !ADD_TO[group.id] && (items.length === 1 || items.every((i) => i.locked));
    if (single) merged.push(...items.map((item) => ({ item, gid: group.id })));
    else tabs.push({ id: group.id, label: group.label, entries: items.map((item) => ({ item, gid: group.id })) });
  }
  if (merged.length) {
    tabs.push({ id: MERGED, label: merged.every((e) => e.gid.startsWith('pagina-')) ? 'Páginas' : 'Geral', entries: merged });
  }
}
/** The tab an item's group belongs to; "Novo projeto" and "Ordem" belong to Projetos. */
const tabOf = (gid: string) => (ACTION_GROUPS.has(gid) ? 'projetos' : tabs.find((tb) => tb.entries.some((e) => e.gid === gid))?.id ?? gid);
const asked = groupId ? tabOf(groupId) : Astro.url.searchParams.get('g');
const activeTab = tabs.find((tb) => tb.id === asked) ?? tabs[0] ?? null;
const addGroup = activeTab && ADD_TO[activeTab.id]
  ? current?.groups.find((g) => g.group.id === ADD_TO[activeTab.id]) ?? null : null;
const orderGroup = activeTab?.id === 'projetos' ? current?.groups.find((g) => g.group.id === 'ordem') ?? null : null;
const tabHref = (id: string) => `${href(current!.area.id)}?g=${encodeURIComponent(id)}`;

/* The projects toolbar: the categories and years that actually occur, newest year first. */
const facetItems = activeTab?.entries.map((e) => e.item).filter((i) => i.facets) ?? [];
const categoryNames = new Map((await getCollection('categories')).map((c) => [c.id, c.data.name.pt]));
const facetCategories = [...new Set(facetItems.flatMap((i) => i.facets!.categories))]
  .map((id) => ({ id, name: categoryNames.get(id) ?? id }))
  .sort((a, b) => a.name.localeCompare(b.name, 'pt'));
const facetYears = [...new Set(facetItems.map((i) => i.facets!.year))].sort().reverse();

/* The open modal: what it holds, and where closing it goes. */
const modal = item && current ? {
  title: newProject ? 'Novo projeto' : orderEditor ? 'Ordem do portfólio' : item.label,
  back: tabHref(activeTab?.id ?? groupId!),
  form: Boolean((screen && editor) || entryEditor || orderEditor || projectEditor),
  wide: Boolean(item.viewPath),
} : null;
---

<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{modal ? `${modal.title} · ` : area ? `${area.label} · ` : ''}Admin · Next Vision Films</title>
  </head>
  <body class="admin">
    <aside class="ad-side">
      <a class="ad-brand" href={href()} aria-current={!area ? 'page' : undefined}>NVF <span>Admin</span></a>
      <nav aria-label="Secções">
        <ul class="ad-sections">
          {AREAS.map((a) => (
            <li data-section={a.section ?? undefined}>
              <a href={href(a.id)} aria-current={a === area ? 'page' : undefined}><i aria-hidden="true"></i>{a.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="ad-side__foot">
        <p data-build>Site: a verificar…</p>
        <p>{who.email} · <a href={LOGOUT_PATH}>Sair</a></p>
      </div>
    </aside>

    <div class="ad-main" data-section={current?.area.section ?? undefined}>
      <header class="ad-head">
        <h1>{current ? current.area.label : 'Conteúdo do site'}</h1>
        <div class="ad-head__actions">
          <button type="button" class="ad-button ad-button--primary" data-publish-open>Publicar <span data-draft-count></span></button>
          {addGroup && addGroup.items[0] ? (
            <a class="ico ico--add ico--lg" href={href(current!.area.id, addGroup.group.id, addGroup.items[0].id)}
              aria-label={addGroup.group.label} title={addGroup.group.label} set:html={ICON.add} />
          ) : null}
        </div>
        {tabs.length > 1 ? (
          <nav class="ad-tabs" aria-label={`${current!.area.label}: o que editar`}>
            {tabs.map((tb) => (
              <a href={tabHref(tb.id)} aria-current={tb === activeTab ? 'page' : undefined}>
                {tb.label}{tb.entries.length > 1 ? <span>{tb.entries.length}</span> : null}
              </a>
            ))}
          </nav>
        ) : null}
      </header>

      {!current ? (
        <main class="ad-panel">
          <p class="ad-lede">Escolha uma secção para ver e alterar o que lá aparece. As alterações ficam guardadas neste computador e só chegam ao site quando carregar em Publicar.</p>
          <ul class="ad-grid">
            {loaded.map((l) => (
              <li class="ad-card ad-card--section" data-section={l.area.section ?? undefined}>
                <a class="ad-card__link" href={href(l.area.id)}>
                  <h2 class="ad-card__title">{l.area.label}</h2>
                  <p class="ad-card__meta">{l.groups.filter(({ group, items }) => !ACTION_GROUPS.has(group.id) && (items.length > 0 || ADD_TO[group.id])).map((g) => `${g.group.label}${g.items.length > 1 ? ` (${g.items.length})` : ''}`).join(', ')}</p>
                </a>
              </li>
            ))}
          </ul>
        </main>
      ) : activeTab ? (
        <main class="ad-panel" data-grid>
          <h2 class="visually-hidden">{activeTab.label}</h2>
          {activeTab.entries.length > SEARCH_FROM || facetItems.length || orderGroup ? (
            <form class="ad-toolbar" role="search" data-toolbar>
              {activeTab.entries.length > SEARCH_FROM ? (
                <label class="ad-search">
                  <span class="visually-hidden">Procurar</span>
                  <i aria-hidden="true" set:html={ICON.search}></i>
                  <input type="search" name="q" placeholder={`Procurar em ${activeTab.label.toLocaleLowerCase('pt-PT')}`} autocomplete="off" data-filter="q" />
                </label>
              ) : null}
              {facetItems.length ? (
                <>
                  <label class="ad-select"><span>Categoria</span>
                    <select name="categoria" data-filter="categoria">
                      <option value="">Todas</option>
                      {facetCategories.map((c) => <option value={c.id}>{c.name}</option>)}
                    </select>
                  </label>
                  <label class="ad-select"><span>Ano</span>
                    <select name="ano" data-filter="ano">
                      <option value="">Todos</option>
                      {facetYears.map((y) => <option value={y}>{y}</option>)}
                    </select>
                  </label>
                  <label class="ad-select"><span>Estado</span>
                    <select name="estado" data-filter="estado">
                      <option value="">Todos</option>
                      <option value="site">No site</option>
                      <option value="escondido">Escondidos</option>
                      <option value="alterado">Com alterações por publicar</option>
                      <option value="apagar">A apagar ao publicar</option>
                    </select>
                  </label>
                  <label class="ad-select"><span>Ordenar</span>
                    <select name="ordem" data-filter="ordem">
                      <option value="">Ordem do portfólio</option>
                      <option value="recentes">Mais recentes</option>
                      <option value="nome">Nome, A–Z</option>
                    </select>
                  </label>
                </>
              ) : null}
              {orderGroup && orderGroup.items[0] ? (
                <a class="ad-button" href={href(current.area.id, orderGroup.group.id, orderGroup.items[0].id)}>Mudar a ordem</a>
              ) : null}
            </form>
          ) : null}

          {activeTab.entries.length ? (
            <ul class="ad-grid" data-cards>
              {activeTab.entries.map(({ item: i, gid }, n) => (
                <ItemCard item={i} index={n} editHref={href(current.area.id, gid, i.id)} readOnly={!editable(gid, i)} />
              ))}
            </ul>
          ) : (
            <p class="ad-empty">Ainda não há nenhum. Quando houver, aparece aqui.</p>
          )}
          <p class="ad-empty" data-no-results hidden>Nenhum resultado com estes filtros. <button type="button" class="ad-link" data-filter-reset>Limpar os filtros</button></p>
          <nav class="ad-pages" aria-label="Páginas de resultados" data-pages hidden></nav>
        </main>
      ) : null}
    </div>

    {/* The edit modal: this URL renders the grid with the item open over it (plan §6). */}
    {modal && item ? (
      <dialog class:list={['ad-modal', { 'ad-modal--wide': modal.wide }]} data-edit-dialog data-back={modal.back} aria-labelledby="modal-h">
        <header class="ad-modal__head">
          <h2 id="modal-h">{modal.title}</h2>
          <a class="ico ico--close" href={modal.back} data-modal-cancel aria-label="Fechar" title="Fechar" set:html={ICON.close} />
        </header>
        <div class="ad-modal__body">
          <div class="ad-modal__form">
            {item.locked ? <p class="admin-locked">{item.locked}</p> : null}
            {screen && editor ? (
              <Editor screen={screen} fields={editor.fields} docs={editor.docs} uploads={editor.uploads} />
            ) : entryEditor ? (
              <EntryEditor type={entryEditor.type} id={entryEditor.id} data={entryEditor.data} uploads={entryEditor.uploads} />
            ) : newProject ? (
              <NewProject categories={newProject} />
            ) : orderEditor ? (
              <OrderEditor projects={orderEditor} />
            ) : projectEditor ? (
              <ProjectEditor slug={projectEditor.slug} data={projectEditor.data} categories={projectEditor.categories} uploads={projectEditor.uploads} />
            ) : (
              <>
                {editorNotice ? <p class="admin-locked">{editorNotice}</p> : null}
                {!item.locked && !editable(groupId!, item) && groupId !== 'novo' ? <p class="admin-readonly">Esta parte, por agora, só se consulta.</p> : null}
                <Field value={item.data} />
              </>
            )}
            {item.body?.trim() ? (
              <details class="admin-body">
                <summary>Texto do ficheiro</summary>
                <pre>{item.body.trim()}</pre>
              </details>
            ) : null}
          </div>
          {item.viewPath ? (
            <aside class="admin-viewer" aria-label="Página no site">
              <p>No site: <a href={item.viewPath} target="_blank" rel="noopener">abrir {item.viewPath} numa janela nova</a></p>
              <iframe src={item.viewPath} title={`A página ${item.viewPath} no site`} loading="lazy"></iframe>
            </aside>
          ) : null}
        </div>
        <footer class="ad-modal__foot">
          {modal.form ? (
            <>
              <p class="ad-modal__hint">Guardar mantém as alterações neste computador. Chegam ao site quando carregar em Publicar.</p>
              <a class="ad-button" href={modal.back} data-modal-cancel>Cancelar</a>
              <a class="ad-button ad-button--primary" href={modal.back} data-modal-save>Guardar</a>
            </>
          ) : (
            <a class="ad-button" href={modal.back} data-modal-cancel>Fechar</a>
          )}
        </footer>
      </dialog>
    ) : null}

    {/* Delete: asks first; confirming marks the item for deletion at the next Publicar. */}
    <dialog class="ad-modal ad-modal--small" data-confirm-dialog aria-labelledby="confirm-h">
      <h2 id="confirm-h" data-confirm-title>Apagar?</h2>
      <p>Sai do site quando carregar em Publicar. Até lá pode desfazer.</p>
      <p class="ad-modal__hint">As imagens e os vídeos ficam guardados. Quem abrir o endereço antigo vai parar ao portfólio.</p>
      <div class="ad-modal__foot">
        <button type="button" class="ad-button" data-confirm-cancel>Cancelar</button>
        <button type="button" class="ad-button ad-button--danger" data-confirm-go>Apagar</button>
      </div>
    </dialog>

    {/* One Publicar for every draft on every page (A10). Filled by admin-client.ts. */}
    <dialog class="pub-dialog ad-modal ad-modal--small" data-publish-dialog aria-labelledby="pub-h">
      <h2 id="pub-h">Publicar no site</h2>
      <div data-publish-list></div>
      <p class="ed-note" data-publish-note>Estas alterações só existem neste computador até publicar. Publicar põe-nas em nextvisionfilms.com, normalmente em 2 a 3 minutos.</p>
      <div class="pub-actions">
        <button type="button" class="ad-button ad-button--primary" data-publish-go>Publicar</button>
        <button type="button" class="ad-button" data-publish-close>Fechar</button>
        <button type="button" class="pub-cancel" data-publish-discard>Descartar todos os rascunhos</button>
      </div>
      <p class="ed-message" role="status" aria-live="polite" data-publish-message></p>
    </dialog>

    <script>
      import './admin-client.ts';
    </script>
  </body>
</html>
