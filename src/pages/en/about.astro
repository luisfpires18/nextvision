---
/**
 * /en/about/
 *
 * A ROUTE, not a page. The page itself is AboutPage.astro, which takes a
 * locale and is mounted twice — once here and once under /en/ — so the Portuguese and
 * English versions of this page cannot drift apart into two designs of the same content.
 * That split is the whole of the PT/EN architecture (docs/SEO_I18N_ROLLOUT.md §1).
 */
import AboutPage from '../../components/pages/AboutPage.astro';
---

<AboutPage locale="en" />
